# Nightshift AI SRE - Backend Environment Variables
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration ('anthropic', 'gemini', or 'mock')
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# GitHub Tools Settings
GITHUB_REPO=srinibasnayak23/BloHelp
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_COMMITS_LIMIT=5

# Agent Reasoning & Escalation Threshold
CONFIDENCE_THRESHOLD=0.7

# Render Automated Remediation & Log Ingestion Settings
RENDER_API_KEY=rnd_your_render_api_key_here
RENDER_OWNER_ID=tea_your_render_owner_id_here
RENDER_TARGET_SERVICE_ID=srv_your_render_service_id_here
RENDER_BASE_URL=https://api.render.com/v1
RENDER_POLL_INTERVAL_SECONDS=15
RENDER_SERVICE_NAME=BloHelp
